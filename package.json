{
  "name": "vantisweb-e2e-tests",
  "version": "1.1.0",
  "description": "E2E tests for VantisWeb browser",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:allure:generate": "allure generate allure-results --clean -o allure-report",
    "test:allure:open": "allure open allure-report",
    "test:allure:serve": "allure serve allure-results",
    "test:allure:history": "allure generate allure-results --clean -o allure-report --history",
    "install:browsers": "playwright install --with-deps",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:first": "standard-version --first-release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.24.0",
    "allure-playwright": "^2.6.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
